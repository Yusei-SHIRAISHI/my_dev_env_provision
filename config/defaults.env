: "${DEFAULT_DOTFILES_REPO:=Yusei-SHIRAISHI/my_dotfiles}"
: "${APPLY_CHEZMOI:=false}"
: "${INSTALL_EDITORS:=true}"
: "${CHSH_TO_ZSH:=true}"
: "${ENABLE_DOCKER:=true}"
: "${INSTALL_MISE:=true}"
: "${MISE_GLOBAL_TOOLS:=ruby@latest python@latest node@latest rust@latest terraform@latest awscli@latest}"
: "${INSTALL_SYSTEM_SERVICES:=true}"
: "${ENABLE_SSH_SERVICE:=true}"
: "${INSTALL_SYNCTHING:=true}"
: "${ENABLE_SYNCTHING_SERVICE:=true}"
: "${INSTALL_TAILSCALE:=true}"
: "${ENABLE_TAILSCALE_SERVICE:=true}"
: "${INSTALL_FLATPAK_APPS:=true}"
: "${INSTALL_OBSIDIAN:=true}"
: "${INSTALL_CLI_TOOLS:=true}"
: "${INSTALL_BITWARDEN_CLI:=true}"
: "${INSTALL_OPENCODE:=true}"
: "${ENABLE_OPENCODE_SERVICE:=true}"
: "${INSTALL_TGCLI:=true}"
: "${INSTALL_NGROK:=true}"
: "${INSTALL_STRIPE_CLI:=true}"
: "${INSTALL_GCLOUD_CLI:=true}"
: "${INSTALL_LOCAL_APPS:=true}"
: "${INSTALL_OPEN_DESIGN:=true}"
: "${ENABLE_OPEN_DESIGN_SERVICE:=true}"
: "${OPEN_DESIGN_IMAGE:=docker.io/vanjayak/open-design:latest}"
: "${OPEN_DESIGN_PORT:=7456}"
: "${OPEN_DESIGN_MEM_LIMIT:=384m}"

export DEFAULT_DOTFILES_REPO
export APPLY_CHEZMOI
export INSTALL_EDITORS
export CHSH_TO_ZSH
export ENABLE_DOCKER
export INSTALL_MISE
export MISE_GLOBAL_TOOLS
export INSTALL_SYSTEM_SERVICES
export ENABLE_SSH_SERVICE
export INSTALL_SYNCTHING
export ENABLE_SYNCTHING_SERVICE
export INSTALL_TAILSCALE
export ENABLE_TAILSCALE_SERVICE
export INSTALL_FLATPAK_APPS
export INSTALL_OBSIDIAN
export INSTALL_CLI_TOOLS
export INSTALL_BITWARDEN_CLI
export INSTALL_OPENCODE
export ENABLE_OPENCODE_SERVICE
export INSTALL_TGCLI
export INSTALL_NGROK
export INSTALL_STRIPE_CLI
export INSTALL_GCLOUD_CLI
export INSTALL_LOCAL_APPS
export INSTALL_OPEN_DESIGN
export ENABLE_OPEN_DESIGN_SERVICE
export OPEN_DESIGN_IMAGE
export OPEN_DESIGN_PORT
export OPEN_DESIGN_MEM_LIMIT
