: "${DEFAULT_DOTFILES_REPO:=Yusei-SHIRAISHI/my_dotfiles}"
: "${APPLY_CHEZMOI:=false}"
: "${INSTALL_EDITORS:=true}"
: "${CHSH_TO_ZSH:=true}"
: "${ENABLE_DOCKER:=true}"
: "${INSTALL_MISE:=true}"
: "${MISE_GLOBAL_TOOLS:=ruby@latest python@latest node@latest rust@latest terraform@latest awscli@latest}"
: "${INSTALL_SYSTEM_SERVICES:=true}"
: "${ENABLE_SSH_SERVICE:=true}"
: "${INSTALL_SYNCTHING:=true}"
: "${ENABLE_SYNCTHING_SERVICE:=true}"
: "${INSTALL_TAILSCALE:=true}"
: "${ENABLE_TAILSCALE_SERVICE:=true}"
: "${INSTALL_FLATPAK_APPS:=true}"
: "${INSTALL_OBSIDIAN:=true}"
: "${INSTALL_CLI_TOOLS:=true}"
: "${INSTALL_BITWARDEN_CLI:=true}"
: "${INSTALL_OPENCODE:=true}"
: "${ENABLE_OPENCODE_SERVICE:=true}"
: "${INSTALL_HERMES_AGENT:=false}"
: "${INSTALL_TGCLI:=true}"
: "${INSTALL_NGROK:=true}"
: "${INSTALL_STRIPE_CLI:=true}"
: "${INSTALL_GCLOUD_CLI:=true}"
: "${INSTALL_LOCAL_APPS:=true}"
: "${INSTALL_OPEN_DESIGN:=true}"
: "${ENABLE_OPEN_DESIGN_SERVICE:=true}"
: "${OPEN_DESIGN_REPO_URL:=https://github.com/nexu-io/open-design.git}"
: "${OPEN_DESIGN_SOURCE_DIR:=$HOME/.local/share/open-design/source}"
: "${OPEN_DESIGN_DATA_DIR:=$HOME/.local/share/open-design/data}"
: "${OPEN_DESIGN_NODE_VERSION:=24}"
: "${OPEN_DESIGN_PNPM_VERSION:=10.33.2}"
: "${OPEN_DESIGN_NODE_OPTIONS:=--max-old-space-size=2048}"
: "${OPEN_DESIGN_NAMESPACE:=open-design}"
: "${OPEN_DESIGN_PORT:=7456}"
: "${OPEN_DESIGN_DAEMON_PORT:=17456}"
: "${OPEN_DESIGN_WEB_BIND_HOST:=0.0.0.0}"
: "${OPEN_DESIGN_ALLOWED_DEV_ORIGINS:=http://devpc:${OPEN_DESIGN_PORT},http://127.0.0.1:${OPEN_DESIGN_PORT}}"
: "${HERMES_AGENT_INSTALLER_URL:=https://hermes-agent.nousresearch.com/install.sh}"
: "${HERMES_AGENT_HOME:=$HOME/.hermes}"
: "${HERMES_AGENT_INSTALL_DIR:=$HERMES_AGENT_HOME/hermes-agent}"
: "${HERMES_AGENT_BRANCH:=main}"
: "${HERMES_AGENT_COMMIT:=}"
: "${HERMES_AGENT_SKIP_BROWSER:=false}"

export DEFAULT_DOTFILES_REPO
export APPLY_CHEZMOI
export INSTALL_EDITORS
export CHSH_TO_ZSH
export ENABLE_DOCKER
export INSTALL_MISE
export MISE_GLOBAL_TOOLS
export INSTALL_SYSTEM_SERVICES
export ENABLE_SSH_SERVICE
export INSTALL_SYNCTHING
export ENABLE_SYNCTHING_SERVICE
export INSTALL_TAILSCALE
export ENABLE_TAILSCALE_SERVICE
export INSTALL_FLATPAK_APPS
export INSTALL_OBSIDIAN
export INSTALL_CLI_TOOLS
export INSTALL_BITWARDEN_CLI
export INSTALL_OPENCODE
export ENABLE_OPENCODE_SERVICE
export INSTALL_HERMES_AGENT
export INSTALL_TGCLI
export INSTALL_NGROK
export INSTALL_STRIPE_CLI
export INSTALL_GCLOUD_CLI
export INSTALL_LOCAL_APPS
export INSTALL_OPEN_DESIGN
export ENABLE_OPEN_DESIGN_SERVICE
export OPEN_DESIGN_REPO_URL
export OPEN_DESIGN_SOURCE_DIR
export OPEN_DESIGN_DATA_DIR
export OPEN_DESIGN_NODE_VERSION
export OPEN_DESIGN_PNPM_VERSION
export OPEN_DESIGN_NODE_OPTIONS
export OPEN_DESIGN_NAMESPACE
export OPEN_DESIGN_PORT
export OPEN_DESIGN_DAEMON_PORT
export OPEN_DESIGN_WEB_BIND_HOST
export OPEN_DESIGN_ALLOWED_DEV_ORIGINS
export HERMES_AGENT_INSTALLER_URL
export HERMES_AGENT_HOME
export HERMES_AGENT_INSTALL_DIR
export HERMES_AGENT_BRANCH
export HERMES_AGENT_COMMIT
export HERMES_AGENT_SKIP_BROWSER
