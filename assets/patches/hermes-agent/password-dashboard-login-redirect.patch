diff --git a/tests/hermes_cli/test_dashboard_auth_401_reauth.py b/tests/hermes_cli/test_dashboard_auth_401_reauth.py
index 458be58..5b0e844 100644
--- a/tests/hermes_cli/test_dashboard_auth_401_reauth.py
+++ b/tests/hermes_cli/test_dashboard_auth_401_reauth.py
@@ -406,6 +406,33 @@ class TestAutoSsoRedirect:
         assert r.headers["location"].startswith("/login")
         assert "/auth/login" not in r.headers["location"]
 
+    def test_password_provider_renders_login_not_oauth_start(self, gated_app):
+        """A password-form provider cannot be started through /auth/login.
+
+        BasicAuthProvider sets supports_password=True, so a single BasicAuth
+        dashboard must show /login instead of auto-redirecting to the OAuth
+        initiation route.
+        """
+        from tests.hermes_cli.conftest_dashboard_auth import StubAuthProvider
+        from hermes_cli.dashboard_auth import clear_providers, register_provider
+
+        class _PasswordStub(StubAuthProvider):
+            name = "password"
+            display_name = "Password"
+            supports_password = True
+
+            def start_login(self, *, redirect_uri: str):
+                raise AssertionError("password providers do not start OAuth")
+
+        clear_providers()
+        register_provider(_PasswordStub())
+
+        r = gated_app.get("/sessions", follow_redirects=False)
+
+        assert r.status_code == 302
+        assert r.headers["location"].startswith("/login")
+        assert "/auth/login" not in r.headers["location"]
+
 
