[Unit]
Description=Open Design
Documentation=https://github.com/nexu-io/open-design
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/open-design/source
ExecStart=%h/.local/share/open-design/run.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
